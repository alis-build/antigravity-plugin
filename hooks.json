{
  "alis-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./hooks/check-cli.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/load-primer.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/inject-service-context.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/sync-skills.sh",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/check-cli.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/load-primer.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/inject-service-context.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/sync-skills.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/suggest-skills.sh",
        "timeout": 5
      }
    ]
  },
  "alis-cli": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/allow-alis-cli.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "view_file|list_dir|grep_search|find_by_name|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/allow-alis-cli.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "alis-handoff": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash \"./hooks/handoff.sh\" PreInvocation",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "bash \"./hooks/handoff.sh\" PostInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"./hooks/handoff.sh\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"./hooks/handoff.sh\" PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash \"./hooks/handoff.sh\" Stop",
        "timeout": 10
      }
    ]
  }
}
