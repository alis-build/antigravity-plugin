{
  "alis-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/load-primer.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/inject-service-context.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "bash ./hooks/sync-skills.sh",
        "timeout": 5
      }
    ]
  },
  "alis-cli": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/allow-alis-cli.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "alis-handoff": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"./hooks/handoff.py\" antigravity PreInvocation",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 \"./hooks/handoff.py\" antigravity PostInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/handoff.py\" antigravity PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/handoff.py\" antigravity PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"./hooks/handoff.py\" antigravity Stop",
        "timeout": 10
      }
    ]
  }
}
